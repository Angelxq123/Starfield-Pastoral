    { "cmd": "fade", "mode": "in", "ticks": 20 },

    { "cmd": "pause", "ticks": 75 },
    { "cmd": "message", "text": "event.combat_rescue.wake_first" },
    { "cmd": "pause", "ticks": 50 },
    { "cmd": "message", "text": "event.combat_rescue.wake_second" },
    { "cmd": "pause", "ticks": 50 },

    { "cmd": "speak", "npc_id": "$combat_rescuer", "text": "$combat_rescuer_dialogue" },

    { "cmd": "move_actor", "actor": "rescuer",
      "x": 0.5, "y": 66, "z": 1.5, "ticks": 40, "relative": false },
    { "cmd": "remove_actor", "actor": "rescuer" },

    { "cmd": "animate", "actor": "fake_player", "anim": "idle", "loop": false },
    { "cmd": "pause", "ticks": 50 },
    { "cmd": "emote", "actor": "fake_player", "emote": "sad" },
    { "cmd": "pause", "ticks": 30 },
    { "cmd": "end" }
  ]
