{
  "id": "combat_rescue_mine",
  "skippable": false,
  "trigger": { "type": "manual" },
  "preconditions": [],
  "commands": [
    { "cmd": "comment", "text": "=== SDV Data/Events/Mine:PlayerKilled; authored in STARDEW_MINING ===" },
    { "cmd": "lock_player" },
    { "cmd": "spawn_actor", "actor": "fake_player", "npc_id": "player",
      "x": 1.5, "y": 66, "z": -1.5, "relative": false, "facing": 0 },
    { "cmd": "animate", "actor": "fake_player", "anim": "collapsed", "loop": true },

    { "cmd": "spawn_actor", "actor": "rescuer", "npc_id": "$combat_rescuer",
